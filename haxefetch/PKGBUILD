pkgname=haxefetch
pkgver=1.0.0
pkgrel=1
pkgdesc="Fetch program written in Haxe"
arch=('x86_64')
url="https://github.com/Sbinator-hub/Haxefetch"
license=('MIT')
provides=('haxefetch')
conflicts=('haxefetch')

source=("${pkgname}-${pkgver}.tar.gz::https://github.com/Sbinator-hub/Haxefetch/releases/download/${pkgver}/haxefetch-${pkgver}.tar.gz")

sha256sums=('c6608e9d23619f17e6ca8d7b79405d7c392f261cdb9537839baedca52621f5d4')

options=('!debug')

package() {
	install -Dm755 "${srcdir}/haxefetch" "${pkgdir}/usr/bin/haxefetch"
	if [ -f "${srcdir}/haxefetch.fish" ]; then
        install -Dm644 "${srcdir}/haxefetch.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/haxefetch.fish"
    fi
}
