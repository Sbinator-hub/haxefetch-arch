pkgname=haxefetch
pkgver=1.0.0
pkgrel=10
pkgdesc="Fetch program written in Haxe"
arch=('x86_64')
url="https://github.com/Sbinator-hub/Haxefetch"
license=('MIT')

source=(
	"haxefetch::https://github.com/Sbinator-hub/Haxefetch/raw/refs/heads/main/binary/haxefetch"
)

sha256sums=('640efef8828c0a342b0a79e2e94a15edf1928d8dfd2a79aaa8301b07228e0528')

options=('!debug')

package() {
	install -Dm755 haxefetch "$pkgdir/usr/bin/haxefetch"
	install -Dm644 "$startdir/completion/haxefetch.fish" "$pkgdir/usr/share/fish/vendor_completions.d/haxefetch.fish"
	
}
